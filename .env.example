# Copy to `.env` to override database credentials used by Docker Compose.
# `docker compose up` also works without a `.env` file — these same values
# are the defaults baked into compose.yaml (fine for a local sandbox,
# never acceptable for real deployments).
CATEGORY_DB_USER=medata
CATEGORY_DB_PASSWORD=medata
LABTEST_DB_USER=medata
LABTEST_DB_PASSWORD=medata
